  <folder name="Technology &amp; Physical" id="id-a256ea57cd5a4201ae1f21741c81eed5" type="technology"/>
  <folder name="Motivation" id="id-6549421680964ab99a0760136d9f7287" type="motivation">
    <element xsi:type="archimate:Driver" name="Ley de protección de datos personales" id="id-661b59d324bc4c49ac49f6642ad57080">
      <documentation>Regulación ecuatoriana que establece los principios, derechos, obligaciones y medidas para garantizar la protección de los datos personales durante su recopilación, almacenamiento, tratamiento, uso, transferencia y eliminación, exigiendo a las organizaciones implementar controles que aseguren la privacidad, confidencialidad, integridad y disponibilidad de la información personal.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Proteger datos personales" id="id-f90ee4c632c846d4be1894654ad4b306"/>
    <element xsi:type="archimate:Requirement" name="Registrar consentimiento" id="id-f96b44bd70114399b38770309489182c"/>
    <element xsi:type="archimate:Requirement" name="Cifrar información sensible" id="id-efc53b1f4f3446f78dd5681d53aa73ff"/>
    <element xsi:type="archimate:Requirement" name="Clasificar datos personales" id="id-103cac2fd39a484eadcfe12e2337ac82"/>
    <element xsi:type="archimate:Driver" name="Cumplimiento del estándar PCI DSS" id="id-d205c5a0ef36499ebc9afdd78d65294f">
      <documentation>Estándar internacional de seguridad desarrollado por el PCI Security Standards Council que establece los requisitos para proteger los datos de los titulares de tarjetas de pago durante su almacenamiento, procesamiento y transmisión, con el objetivo de reducir el fraude, fortalecer la seguridad de los sistemas de pago y garantizar el cumplimiento de las obligaciones regulatorias y contractuales de la entidad financiera.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Protección de datos" id="id-f98a99f6e23646d98c8774d3c0b190b9"/>
    <element xsi:type="archimate:Requirement" name="Cifrar los datos del titular de la tarjeta." id="id-4a2622c1fac14316812a483d39782e9d"/>
    <element xsi:type="archimate:Requirement" name="Tokenizar el PAN cuando sea posible" id="id-550be43b047c40b99a8ca1ccefa6a27f"/>
    <element xsi:type="archimate:Requirement" name="Registrar y auditar todos los accesos al entorno PCI." id="id-cd01d63fe1174502b74d537b35b5c315"/>
    <element xsi:type="archimate:Requirement" name="Monitorear continuamente eventos de seguridad." id="id-6b9170ff9ff545c3a1fcbb9ecfdf46fc"/>
    <element xsi:type="archimate:Requirement" name="Restringir el acceso basado en roles." id="id-4b7d9c237fb14db09fb514de8812c947"/>
    <element xsi:type="archimate:Requirement" name="Proteger las claves criptográficas." id="id-940445c6eb9c43299e9aa2fd939734fb"/>
  </folder>
